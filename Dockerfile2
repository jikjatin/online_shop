FROM node:23-alpine3.20 AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:alpine3.21
COPY --from=builder /app/build /usr/share/nginx/html
COPY COPY nginx.conf /etc/nginx/conf.d/default.conf  # Use custom Nginx config
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]		
